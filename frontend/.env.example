# Development, test, or production. Production requires an explicit API origin.
# Public deployment remains blocked until backend authentication is implemented.
ARCHMIND_DEPLOY_ENV=development
# Server-side Next.js rewrite target. Use HTTPS for a nonlocal production API.
# Set the same origin at build and runtime. Do not prefix secrets with NEXT_PUBLIC_.
ARCHMIND_API_URL=http://127.0.0.1:8000

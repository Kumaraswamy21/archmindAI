# Replace these example paths with existing, administrator-approved directories.
# These variables contain no credentials; keep real local values in an ignored .env file.
ARCHMIND_APPROVED_REPOSITORY_ROOTS='["/absolute/path/to/approved"]'
ARCHMIND_REPOSITORY_ALIASES='{"sample-ecommerce":"/absolute/path/to/approved/ecommerce-service"}'
# Optional discovery limits (defaults: 10,000 files and 10 MiB per file).
ARCHMIND_DISCOVERY_MAX_FILES=10000
ARCHMIND_DISCOVERY_MAX_FILE_SIZE_BYTES=10485760
# Optional default preview limit in Python characters (1–1,000,000; default 4,000).
ARCHMIND_MAX_CHUNK_CHARS=4000

# Managed remote PostgreSQL only. Put real values in an ignored .env file or
# a secret manager; never commit credentials. No local database is supported.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/archmind
DATABASE_SSL_MODE=require

# Optional Gemini embedding generation for persisted chunks. Keep the real key
# in an ignored local environment or secret manager, never in Git.
# GEMINI_API_KEY=YOUR_API_KEY
EMBEDDING_MODEL=gemini-embedding-2
EMBEDDING_DIMENSION=768
# Dimensions 128–3072 are stored in separate model/dimension spaces.
# No approximate vector index is created in Phase 4.3.
EMBEDDING_BATCH_SIZE=16
EMBEDDING_REQUEST_TIMEOUT_SECONDS=30
EMBEDDING_MAX_RETRIES=2
EMBEDDING_RETRY_BACKOFF_SECONDS=0.25

# Phase 5.2 hybrid retrieval. Both inputs are bounded; no score mixing occurs.
HYBRID_RRF_CONSTANT=60
HYBRID_CANDIDATE_POOL=20

# Grounded answer generation; real GEMINI_API_KEY stays in secrets storage.
RAG_MODEL_IDENTIFIER=gemini-2.5-flash
RAG_TIMEOUT_SECONDS=30
RAG_MAX_CONTEXT_CHARS=16000
# Optional explicit selection of released prompt versions for rollback.
# RAG_SYSTEM_PROMPT_VERSION=1.0.0
# RAG_USER_PROMPT_VERSION=1.0.0

# Optional explicit classifier prompt selection for rollback.
# QUERY_CLASSIFIER_SYSTEM_PROMPT_VERSION=1.0.0
# QUERY_CLASSIFIER_USER_PROMPT_VERSION=1.0.0

# Optional specialist prompt selection; each released kind can roll back independently.
# CODE_ANALYSIS_SYSTEM_PROMPT_VERSION=1.1.0
# CODE_ANALYSIS_USER_PROMPT_VERSION=1.1.0
# DEPENDENCY_ANALYSIS_SYSTEM_PROMPT_VERSION=1.1.0
# DEPENDENCY_ANALYSIS_USER_PROMPT_VERSION=1.1.0
# ARCHITECTURE_ANALYSIS_SYSTEM_PROMPT_VERSION=1.1.0
# ARCHITECTURE_ANALYSIS_USER_PROMPT_VERSION=1.1.0
